<Layouts.marketing current_page={:network}>
  <section class="m-hero" style="padding-bottom: 3rem;">
    <div class="m-container">
      <div class="m-eyebrow">Our Network</div>
      <h1>We connect the world.</h1>
      <p class="m-lede">
        Established in 1994 as part of an alliance with overseas freight forwarding veterans,
        Merstar International is a founding member of the L.I.N.K Global Network — spanning
        68 countries of independent logistics freight forwarding companies.
      </p>
    </div>
  </section>

  <section class="m-section" style="padding-top: 0;">
    <div class="m-container">
      <div class="m-hero-grid">
        <div>
          <h2 style="margin-bottom: 1.2rem;">Strength through our L.I.N.K Global Network.</h2>
          <p style="color: var(--m-sage-text); margin: 0 0 1.1rem;">
            With the L.I.N.K Global Network, Merstar International offers the connectivity with
            cost effectiveness, customized solutions, and timely delivery for shipments to
            different parts of the world.
          </p>
          <p style="color: var(--m-sage-text); margin: 0;">
            The network enables handling of intermodal, multimodal, cross-border trucking, Third
            Party Logistics (3PL), and customs brokerage services.
          </p>
        </div>
        <div class="m-card">
          <div class="m-eyebrow" style="margin-bottom: 1rem;">What Sets Us Apart</div>
          <p style="margin: 0 0 0.9rem; font-size: 0.95rem; color: var(--m-sage-text);">
            In-country knowledge and understanding of cross-border trade regulations.
          </p>
          <p style="margin: 0 0 0.9rem; font-size: 0.95rem; color: var(--m-sage-text);">
            Deep customs expertise across every lane we serve.
          </p>
          <p style="margin: 0; font-size: 0.95rem; color: var(--m-sage-text);">
            On-time delivery, with zero defects.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="m-section" style="background:#ffffff; border-top:1px solid var(--m-line); border-bottom:1px solid var(--m-line);">
    <div class="m-container">
      <div class="m-section-head">
        <div class="m-eyebrow">Global Reach</div>
        <h2>68 countries. One standard of care.</h2>
      </div>
      <div class="m-network-grid">
        <div class="m-network-cell"><div class="m-region">East Asia</div><div class="m-place">Seoul · Tokyo</div></div>
        <div class="m-network-cell"><div class="m-region">Europe</div><div class="m-place">Rotterdam</div></div>
        <div class="m-network-cell"><div class="m-region">Americas</div><div class="m-place">Los Angeles</div></div>
        <div class="m-network-cell"><div class="m-region">Oceania</div><div class="m-place">Sydney</div></div>
        <div class="m-network-cell"><div class="m-region">Africa &amp; Mediterranean</div><div class="m-place">Multi-Port</div></div>
      </div>
    </div>
  </section>

  <section class="m-section">
    <div class="m-container">
      <div class="m-section-head">
        <div class="m-eyebrow">Our Credentials</div>
        <h2>Registered, certified, connected.</h2>
        <p>IATA · FIATA · L.I.N.K Global Network · Singapore Registered · ISO Certified</p>
      </div>
    </div>
  </section>

  <section class="m-section" style="padding-top: 0;">
    <div class="m-container">
      <div class="m-cta-band">
        <div>
          <h2>Ship anywhere our network reaches</h2>
          <p>Tell us the lane — we'll tell you the fastest, most cost-effective way through it.</p>
        </div>
        <a href="/contact-us" class="m-btn m-btn-primary">Request for Quote</a>
      </div>
    </div>
  </section>
</Layouts.marketing>
