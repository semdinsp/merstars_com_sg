<Layouts.marketing current_page={:partnership}>
  <section class="m-hero" style="padding-bottom: 3rem;">
    <div class="m-container">
      <div class="m-eyebrow">Partnership</div>
      <h1>Your partnership in excellence.</h1>
      <p class="m-lede">
        The marketplace is always evolving, and staying current is what keeps a logistics
        pioneer competitive. Merstar welcomes strategic partnerships and views collaboration as
        essential to mutual growth.
      </p>
    </div>
  </section>

  <section class="m-section" style="padding-top: 0;">
    <div class="m-container m-hero-grid">
      <div>
        <h2 style="margin-bottom: 1.2rem;">We look forward to synergize.</h2>
        <p style="color: var(--m-sage-text); margin: 0;">
          We look forward to synergize and value-add Strategic Partnership with Vendors, Clients,
          Competitors, and with Government entities on a Project basis.
        </p>
      </div>
      <div class="m-card">
        <div class="m-eyebrow" style="margin-bottom: 1rem;">Partnership Focus Areas</div>
        <p style="margin: 0; font-size: 0.95rem; color: var(--m-sage-text);">
          Air &amp; Ocean Freight, Customs Clearance, Warehousing, Third Party Logistics, and
          Specialized Services — Pharma Logistics, Perishables, Charter Services, E-Commerce
          Delivery, and Procurement.
        </p>
      </div>
    </div>
  </section>

  <section class="m-section" style="background:#ffffff; border-top:1px solid var(--m-line); border-bottom:1px solid var(--m-line);">
    <div class="m-container">
      <div class="m-section-head">
        <div class="m-eyebrow">Backed By</div>
        <h2>Credentials that make partnership easy.</h2>
      </div>
      <div class="m-network-grid m-cols-3">
        <div class="m-network-cell"><div class="m-region">Since 1991</div><div class="m-place">IATA Member</div></div>
        <div class="m-network-cell"><div class="m-region">Freight Forwarding</div><div class="m-place">FIATA Member</div></div>
        <div class="m-network-cell"><div class="m-region">Quality</div><div class="m-place">ISO Certified</div></div>
      </div>
    </div>
  </section>

  <section class="m-section" style="padding-top: 0;">
    <div class="m-container">
      <div class="m-cta-band">
        <div>
          <h2>Enquiries for Partnership</h2>
          <p>Merstar caters for strategic alliance and partnership.</p>
        </div>
        <a href="/contact-us" class="m-btn m-btn-primary">Contact Us Now</a>
      </div>
    </div>
  </section>
</Layouts.marketing>
