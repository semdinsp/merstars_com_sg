<Layouts.marketing current_page={:home}>
  <section class="m-hero">
    <div class="m-container m-hero-grid">
      <div>
        <div class="m-eyebrow">Changi Airport, Singapore</div>
        <h1>Your partnership<br />in excellence.</h1>
        <p class="m-lede">
          Air, ocean, and overland freight forwarding with dedicated service, cost-effective
          rates, and reliable, on-time delivery — for clients who can't afford a shipment to go
          wrong.
        </p>
        <div class="m-hero-ctas">
          <a href="/request-for-quote" class="m-btn m-btn-primary">Request for Quote</a>
          <a href="/about-us" class="m-btn m-btn-ghost">Read More</a>
        </div>
        <ul class="m-value-list">
          <li>Dedicated Service</li>
          <li>Cost Effective</li>
          <li>Reliability</li>
          <li>On-Time Delivery</li>
        </ul>
      </div>
      <div class="m-manifest">
        <div class="m-manifest-head">
          <span>Typical lanes · SIN hub</span><span>Illustrative</span>
        </div>
        <div class="m-manifest-row">
          <div class="m-route">SIN <span class="m-sep">→</span> ICN</div>
          <div class="m-status-pill m-cleared">Airfreight</div>
        </div>
        <div class="m-manifest-row">
          <div class="m-route">SIN <span class="m-sep">→</span> RTM</div>
          <div class="m-status-pill m-cleared">Ocean Freight</div>
        </div>
        <div class="m-manifest-row">
          <div class="m-route">PEN <span class="m-sep">→</span> SIN</div>
          <div class="m-status-pill m-cleared">Overland</div>
        </div>
        <div class="m-manifest-row">
          <div class="m-route">SIN Bonded Zone</div>
          <div class="m-status-pill m-cleared">Customs</div>
        </div>
      </div>
    </div>
  </section>

  <section class="m-section">
    <div class="m-container">
      <div class="m-section-head">
        <div class="m-eyebrow">Our Network</div>
        <h2>We connect the world.</h2>
        <p>
          Wherever your business — Asia, the Pacific, Australia, North and South America, Europe,
          the Mediterranean, Africa — our L.I.N.K Global Network serves your total freight and
          logistics needs with quick delivery and cost efficiency. L.I.N.K partners are the
          hallmark of excellence, taking care of shippers and consignees across industries
          worldwide.
        </p>
      </div>
      <div class="m-network-grid">
        <div class="m-network-cell"><div class="m-region">East Asia</div><div class="m-place">Seoul · Tokyo</div></div>
        <div class="m-network-cell"><div class="m-region">Europe</div><div class="m-place">Rotterdam</div></div>
        <div class="m-network-cell"><div class="m-region">Americas</div><div class="m-place">Los Angeles</div></div>
        <div class="m-network-cell"><div class="m-region">Oceania</div><div class="m-place">Sydney</div></div>
        <div class="m-network-cell"><div class="m-region">68 Countries</div><div class="m-place">L.I.N.K Global</div></div>
      </div>
      <p style="margin-top: 2rem;"><a href="/our-network" class="m-link">Read More →</a></p>
    </div>
  </section>

  <section class="m-section-tight" style="background: #ffffff; border-top: 1px solid var(--m-line); border-bottom: 1px solid var(--m-line);">
    <div class="m-container" style="display:flex; justify-content:space-between; align-items:center; gap:2rem; flex-wrap:wrap;">
      <div>
        <div class="m-eyebrow">Logistics handlers since 1989</div>
        <h2 style="font-size: 1.4rem;">We deliver with care.</h2>
      </div>
      <a href="/request-for-quote" class="m-btn m-btn-primary">Request for Quote</a>
    </div>
  </section>

  <section class="m-section">
    <div class="m-container">
      <div class="m-hero-grid">
        <div>
          <div class="m-eyebrow">Merstar International</div>
          <h2 style="margin-bottom: 1.2rem;">Reliable. Cost-effective. On time — every time.</h2>
          <p style="color: var(--m-sage-text); margin: 0 0 1.1rem;">
            Your Partnership in Excellence is Merstar International's commitment to reliable,
            cost-effective, and timely deliveries. We value clients through extending these
            quality services and working towards achieving mutual growth.
          </p>
          <p style="color: var(--m-sage-text); margin: 0 0 1.6rem;">
            Whatever transportation, forwarding, or logistics needs you have, you can count on
            Merstar International's dedicated and experienced team. We put our commitment to the
            fore in every given task and job in delivering "on time delivery" with reliable
            service and competitive rates.
          </p>
          <a href="/about-us" class="m-link">Read More →</a>
        </div>
        <div class="m-card">
          <div class="m-eyebrow" style="margin-bottom: 1.2rem;">Free Trade Zone · Changi</div>
          <p style="color: var(--m-sage-text); font-size: 0.92rem; margin:0;">
            7 Airline Road, Cargo Agents Building E, Changi Airfreight Centre — a dedicated team
            of more than 100 years of combined expertise, operating within the Free Trade Zone
            with advanced EDI systems.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="m-section">
    <div class="m-container">
      <div class="m-section-head">
        <div class="m-eyebrow">Our Services</div>
        <h2>Full-chain freight, forwarding, and logistics.</h2>
      </div>
      <div class="m-services-list">
        <a href="/services" class="m-service-row">
          <div class="m-num">01</div>
          <h3>Airfreight</h3>
          <p>On-time delivery is crucial for every shipment. Our network of airlines and partners are your assurance of reliability.</p>
        </a>
        <a href="/services" class="m-service-row">
          <div class="m-num">02</div>
          <h3>Ocean Freight</h3>
          <p>When costs matter, Ocean Freight is the answer to cost savings for non-Just-in-Time shipments.</p>
        </a>
        <a href="/services" class="m-service-row">
          <div class="m-num">03</div>
          <h3>Transportation / Overland Trucking Delivery</h3>
          <p>We take good care of getting clients' deliveries expeditiously from point to point, locally to cross border.</p>
        </a>
        <a href="/services" class="m-service-row">
          <div class="m-num">04</div>
          <h3>Customs Clearance &amp; Total Documentation</h3>
          <p>We take care of clients' shipments efficiently as we stay connected on the myriad of customs regulations and compliance.</p>
        </a>
      </div>
      <p style="margin-top: 2rem;"><a href="/services" class="m-link">View All Services →</a></p>
    </div>
  </section>

  <section class="m-section">
    <div class="m-container">
      <div class="m-card m-testimonial">
        <blockquote>
          “The stellar service we received from Merstar International over the years has been
          exemplary. They always go the extra distance and do whatever it takes to get the job
          done, and get it done on time and on budget. They function like a part of our team and
          handled our shipments from one country to another on schedule.”
        </blockquote>
        <cite>HSS, Director of Large Automobile Conglomerate</cite>
      </div>
    </div>
  </section>

  <section class="m-section" style="padding-top: 0;">
    <div class="m-container">
      <div class="m-cta-band">
        <div>
          <h2>Enquiries for Partnership</h2>
          <p>Merstar caters for strategic alliance and partnership.</p>
        </div>
        <a href="/partnership" class="m-btn m-btn-primary">Contact Us Now</a>
      </div>
    </div>
  </section>
</Layouts.marketing>
