<Layouts.marketing current_page={:about}>
  <section class="m-hero" style="padding-bottom: 3rem;">
    <div class="m-container">
      <div class="m-eyebrow">About Us</div>
      <h1>Merger of Stars.</h1>
      <p class="m-lede">
        Merstar International was incorporated in 1989 — an acronym for "Merger of Stars" —
        founded through industry veterans offering comprehensive logistics services across air,
        sea, and land freight forwarding.
      </p>
    </div>
  </section>

  <section class="m-section" style="padding-top: 0;">
    <div class="m-container">
      <div class="m-card">
        <div class="m-eyebrow" style="margin-bottom: 1rem;">Merstar International + Planet Logistics</div>
        <h2 style="margin-bottom: 1rem;">A logistics powerhouse, forged from two industry veterans.</h2>
        <p style="color: var(--m-sage-text); margin: 0;">
          Effective 1 January 2024, Merstar International (Singapore) Pte Ltd combined forces with
          Planet Logistics Pte Ltd — a strategic alliance bringing together more than 100 years
          of combined expertise into a single, larger logistics organization. The merger pairs
          Merstar's history in freight forwarding since 1989 with Planet Logistics' operational
          and finance expertise, giving clients comprehensive solutions and superior service on
          a global scale.
        </p>
        <p style="margin-top: 1.2rem;"><a href="/team" class="m-link">Meet the leadership team →</a></p>
      </div>
    </div>
  </section>

  <section class="m-section">
    <div class="m-container m-hero-grid">
      <div>
        <h2 style="margin-bottom: 1.2rem;">A dedicated team, 100+ years of combined experience.</h2>
        <p style="color: var(--m-sage-text); margin: 0 0 1.1rem;">
          Our organization maintains a dedicated team with more than 100 years of combined
          expertise and experience, handling diverse shipment types both locally and
          internationally with tailored solutions.
        </p>
        <p style="color: var(--m-sage-text); margin: 0;">
          We operate from Changi Airfreight Centre, positioned within the Free Trade Zone with
          advanced EDI systems — giving clients the reach and the responsiveness that time-critical
          freight demands.
        </p>
      </div>
      <div class="m-card">
        <div class="m-eyebrow" style="margin-bottom: 1rem;">Location</div>
        <p style="margin: 0; font-size: 0.95rem;">
          7 Airline Road #02-09<br />
          Cargo Agents Building E<br />
          Changi Airfreight Centre<br />
          Singapore 819834
        </p>
      </div>
    </div>
  </section>

  <section class="m-section" style="background:#ffffff; border-top:1px solid var(--m-line); border-bottom:1px solid var(--m-line);">
    <div class="m-container">
      <div class="m-section-head">
        <div class="m-eyebrow">Certifications &amp; Memberships</div>
        <h2>Credentials that back every shipment.</h2>
      </div>
      <div class="m-network-grid">
        <div class="m-network-cell"><div class="m-region">Since 1991</div><div class="m-place">IATA Member</div></div>
        <div class="m-network-cell"><div class="m-region">Freight Forwarding</div><div class="m-place">FIATA Member</div></div>
        <div class="m-network-cell"><div class="m-region">Singapore</div><div class="m-place">SAAA Member</div></div>
        <div class="m-network-cell"><div class="m-region">Quality</div><div class="m-place">ISO Certified</div></div>
        <div class="m-network-cell"><div class="m-region">Valuables</div><div class="m-place">Class A Licensed</div></div>
      </div>
      <p style="margin-top: 2rem; color: var(--m-sage-text);">
        Merstar International is a founding member of the L.I.N.K Global Network, spanning
        68 countries.
      </p>
    </div>
  </section>

  <section class="m-section">
    <div class="m-container">
      <div class="m-section-head">
        <div class="m-eyebrow">What We Handle</div>
        <h2>Core &amp; specialized services.</h2>
      </div>
      <div class="m-hero-grid">
        <div class="m-card">
          <h3 style="margin-bottom: 0.8rem;">Core Services</h3>
          <p style="color: var(--m-sage-text); font-size: 0.95rem; margin:0;">
            Airfreight, Ocean Freight, Transportation/Trucking, Customs Clearance, Warehousing,
            Third Party Logistics, Project Freight.
          </p>
        </div>
        <div class="m-card">
          <h3 style="margin-bottom: 0.8rem;">Specialized Services</h3>
          <p style="color: var(--m-sage-text); font-size: 0.95rem; margin:0;">
            Ship supplies, Pharma Logistics, Perishables, AOG, Charter services, Procurement,
            E-Commerce delivery.
          </p>
        </div>
      </div>
      <p style="margin-top: 2rem;"><a href="/services" class="m-link">View All Services →</a></p>
    </div>
  </section>

  <section class="m-section" style="padding-top: 0;">
    <div class="m-container">
      <div class="m-cta-band">
        <div>
          <h2>Talk to our team</h2>
          <p>Reliable, cost-effective, and timely — that's the Merstar commitment.</p>
        </div>
        <a href="/contact-us" class="m-btn m-btn-primary">Contact Us</a>
      </div>
    </div>
  </section>
</Layouts.marketing>
