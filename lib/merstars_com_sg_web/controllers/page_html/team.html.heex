<Layouts.marketing current_page={:team}>
  <section class="m-hero" style="padding-bottom: 3rem;">
    <div class="m-container">
      <div class="m-eyebrow">Our Team</div>
      <h1>Leadership, forged from two industry veterans.</h1>
      <p class="m-lede">
        Effective 1 January 2024, Merstar International merged with Planet Logistics —
        bringing over 60 years of combined logistics expertise under one leadership team.
      </p>
    </div>
  </section>

  <section class="m-section" style="padding-top: 0;">
    <div class="m-container">
      <div class="m-section-head">
        <div class="m-eyebrow">Executive Leadership</div>
        <h2>The people driving the merger.</h2>
      </div>
      <div class="m-team-grid">
        <div class="m-person-card">
          <div class="m-person-photo">
            <img src={~p"/images/team-ronnie-see.png"} alt="Ronnie See" />
          </div>
          <h3>Ronnie See</h3>
          <div class="m-person-role">Founder &amp; Chairman</div>
          <p class="m-person-bio">
            The driving force behind Merstar International's success since its inception in
            1989. Ronnie's strategic vision and dedication to comprehensive logistics solutions
            have earned the company a reputation as a trusted and reliable partner. He continues
            to oversee overall strategic direction, ensuring a seamless integration and
            continued commitment to excellence.
          </p>
        </div>
        <div class="m-person-card">
          <div class="m-person-photo">E</div>
          <h3>Eddy Quek</h3>
          <div class="m-person-role">Chief Executive Officer</div>
          <p class="m-person-bio">
            Former CEO of Planet Logistics, now leads Merstar International. His 32-year track
            record of visionary leadership focuses on supply chain optimization, innovation, and
            global expansion — with an emphasis on team empowerment to drive collective success.
          </p>
        </div>
        <div class="m-person-card">
          <div class="m-person-photo">W</div>
          <h3>Winnie Tan</h3>
          <div class="m-person-role">Senior Director</div>
          <p class="m-person-bio">
            Co-Founder of Planet Logistics (est. 1992). Wealth of experience from multinational
            logistics giants including DHL, Lep International, and Kuehne + Nagel, bringing deep
            finance, operations, and industry-connection expertise to the combined entity.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="m-section" style="background:#ffffff; border-top:1px solid var(--m-line); border-bottom:1px solid var(--m-line);">
    <div class="m-container">
      <div class="m-section-head">
        <div class="m-eyebrow">Operations &amp; Support</div>
        <h2>The team behind every shipment.</h2>
      </div>
      <div class="m-team-grid">
        <div class="m-person-card">
          <div class="m-person-photo">J</div>
          <h3>Jeannie See</h3>
          <div class="m-person-role">PA to Chairman</div>
        </div>
        <div class="m-person-card">
          <div class="m-person-photo">R</div>
          <h3>Robin Teoh</h3>
          <div class="m-person-role">Senior Operations Manager</div>
        </div>
        <div class="m-person-card">
          <div class="m-person-photo">R</div>
          <h3>Razlinda Rahman</h3>
          <div class="m-person-role">Senior Customer Service Manager</div>
        </div>
        <div class="m-person-card">
          <div class="m-person-photo">M</div>
          <h3>Mike Thia</h3>
          <div class="m-person-role">Operations Manager</div>
        </div>
        <div class="m-person-card">
          <div class="m-person-photo">D</div>
          <h3>Daryani Ahlias</h3>
          <div class="m-person-role">Ocean Freight Executive</div>
        </div>
        <div class="m-person-card">
          <div class="m-person-photo">H</div>
          <h3>Hew Kah Mun</h3>
          <div class="m-person-role">Senior Logistics Associate</div>
        </div>
        <div class="m-person-card">
          <div class="m-person-photo">E</div>
          <h3>Edgar Quek</h3>
          <div class="m-person-role">Logistics Associate</div>
        </div>
      </div>
    </div>
  </section>

  <section class="m-section" style="padding-top: 0;">
    <div class="m-container">
      <div class="m-cta-band">
        <div>
          <h2>Talk to the team</h2>
          <p>Reach us directly at operations@merstar.com.sg or (65) 6545-8833.</p>
        </div>
        <a href="/contact-us" class="m-btn m-btn-primary">Contact Us</a>
      </div>
    </div>
  </section>
</Layouts.marketing>
