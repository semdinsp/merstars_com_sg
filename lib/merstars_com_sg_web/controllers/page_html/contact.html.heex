<Layouts.marketing current_page={:contact}>
  <section class="m-hero" style="padding-bottom: 3rem;">
    <div class="m-container">
      <div class="m-eyebrow">Contact Us</div>
      <h1>Let's move your next shipment.</h1>
      <p class="m-lede">
        If you would like to get in touch with us today, reach out directly or fill in the form
        below.
      </p>
    </div>
  </section>

  <section class="m-section" style="padding-top: 0;">
    <div class="m-container m-hero-grid m-align-top">
      <div>
        <div class="m-contact-rows">
          <div class="m-contact-row">
            <span class="m-contact-label">Address</span>
            <span>
              7 Airline Road #02-09, Cargo Agents Building E,<br />
              Changi Airfreight Centre, Singapore 819834
            </span>
          </div>
          <div class="m-contact-row">
            <span class="m-contact-label">Main</span>
            <a href="tel:+6565458833" class="m-link">(65) 6545-8833</a>
          </div>
          <div class="m-contact-row">
            <span class="m-contact-label">Sales</span>
            <a href="tel:+6565458266" class="m-link">(65) 6545-8266</a>
          </div>
          <div class="m-contact-row">
            <span class="m-contact-label">Air &amp; Ocean</span>
            <a href="tel:+6565432663" class="m-link">(65) 6543-2663</a>
          </div>
          <div class="m-contact-row">
            <span class="m-contact-label">Email</span>
            <a href="mailto:sales@merstar.com.sg" class="m-link">sales@merstar.com.sg</a>
          </div>
        </div>
      </div>

      <div class="m-card" id="form">
        <h3 style="margin-bottom: 1.4rem;">Send us a message</h3>
        <.inquiry_notice flash={@flash} />
        <.form for={@form} action={~p"/contact-us"} class="m-form" novalidate>
          <div class="m-form-row">
            <.inquiry_field field={@form[:name]} label="Name" placeholder="Your name" autocomplete="name" />
            <.inquiry_field
              field={@form[:phone]}
              label="Phone"
              type="tel"
              placeholder="Your phone number"
              autocomplete="tel"
            />
          </div>
          <div class="m-form-row">
            <.inquiry_field
              field={@form[:email]}
              label="Email"
              type="email"
              placeholder="you@company.com"
              autocomplete="email"
            />
            <.inquiry_field field={@form[:subject]} label="Subject" placeholder="What's this about?" />
          </div>
          <.inquiry_field
            field={@form[:message]}
            label="Message"
            type="textarea"
            rows="5"
            placeholder="Tell us about your shipment"
          />
          <.honeypot />
          <.turnstile action="contact" error={assigns[:captcha_error]} />
          <p class="m-form-consent">
            By submitting this form, you consent to Merstar International (Singapore) Pte Ltd
            collecting, using and disclosing your personal data to respond to your enquiry, as
            described in our <a href="/privacy-policy" class="m-link">Privacy Policy</a>.
          </p>
          <button type="submit" class="m-btn m-btn-primary" style="justify-self: start;">Submit</button>
        </.form>
      </div>
    </div>
  </section>
</Layouts.marketing>
